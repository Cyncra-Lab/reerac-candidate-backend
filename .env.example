PORT=4100
API_PREFIX=v1
DATABASE_URL=postgresql://user:pass@localhost:5432/reerac_candidate
# Shared Next.js app (reerac-ai) — recruiter + candidate UI on one origin
FRONTEND_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-candidate-auth-secret
# Browser-facing origin (Next app) — NOT the Railway API URL.
# Production example: https://reerac.ng
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Cloud → OAuth client → Authorized redirect URIs must include:
#   {BETTER_AUTH_URL}/api/candidate-auth/callback/google
# e.g. http://localhost:3000/api/candidate-auth/callback/google
#      https://www.reerac.ng/api/candidate-auth/callback/google
# Apply / job sync only — candidates do NOT log in via B2B
B2B_API_URL=http://localhost:4000/v1
B2B_SERVICE_TOKEN=dev-b2b-service-token
# Used only by scripts/migrate-b2b-candidates.ts (read applicants + backfill externalCandidateId)
B2B_DATABASE_URL=postgresql://user:pass@localhost:5432/reerac_b2b
REDIS_URL=redis://localhost:6379
# Required for email OTP in non-local environments
RESEND_API_KEY=
# Must be a Resend-verified domain (same as B2B)
RESEND_FROM_EMAIL=Reerac AI <no-reply@notifications.reerac.ng>
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
WHATSAPP_HANDOFF_WEBHOOK_URL=
# Optional override; falls back to WHATSAPP_HANDOFF_WEBHOOK_URL
LINKEDIN_HANDOFF_WEBHOOK_URL=
# Required to run POST /v1/notifications/lifecycle/run
LIFECYCLE_CRON_SECRET=
# AI scoring / mocks / matching (Groq preferred)
GROQ_API_KEY=
OPENAI_API_KEY=
CANDIDATE_LLM_MODEL=llama-3.3-70b-versatile
